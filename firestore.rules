rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email == 'eloverdemanaus@gmail.com';
    }

    function hasValidReservationFields() {
      return request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'date', 'notes',
        'status', 'updatedBy', 'createdAt', 'updatedAt'
      ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.date is string
        && request.resource.data.notes is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidStatus() {
      return request.resource.data.status in [
        'Pendente contato', 'Reservado', 'Quitado', 'Visita'
      ];
    }

    function blocksDate(data) {
      return data.status in ['Reservado', 'Quitado'];
    }

    function lockPath(date) {
      return /databases/$(database)/documents/reservationDateLocks/$(date);
    }

    function hasMatchingLock(bookingId) {
      return existsAfter(lockPath(request.resource.data.date))
        && getAfter(lockPath(request.resource.data.date)).data.reservationId == bookingId;
    }

    match /reservationIntents/{bookingId} {
      // Public visitors can only create pending contact requests.
      allow create: if hasValidReservationFields()
        && request.auth == null
        && request.resource.data.status == 'Pendente contato'
        && request.resource.data.updatedBy == 'site';

      // Staff can create any valid status, including multiple visits per date.
      allow create: if hasValidReservationFields()
        && hasValidStatus()
        && isStaff()
        && request.resource.data.updatedBy == request.auth.token.email
        && (!blocksDate(request.resource.data) || hasMatchingLock(bookingId));

      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedBy', 'updatedAt'
        ])
        && hasValidStatus()
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedAt is timestamp
        && (
          (blocksDate(request.resource.data) && hasMatchingLock(bookingId))
          || (!blocksDate(request.resource.data)
            && (!blocksDate(resource.data) || !existsAfter(lockPath(resource.data.date))))
        );
      allow delete: if isStaff()
        && (!blocksDate(resource.data) || !existsAfter(lockPath(resource.data.date)));
    }

    match /reservationDateLocks/{date} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
          'reservationId', 'date', 'status', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.date == date
        && request.resource.data.reservationId is string
        && request.resource.data.status in ['Reservado', 'Quitado']
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isStaff();
    }
  }
}
