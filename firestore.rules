rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email == 'eloverdemanaus@gmail.com';
    }

    function hasValidReservationFields() {
      return request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'date', 'notes',
        'status', 'updatedBy', 'createdAt', 'updatedAt'
      ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.date is string
        && request.resource.data.notes is string
        && request.resource.data.status == 'Pendente contato'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /reservationIntents/{bookingId} {
      // The public site may create requests identified as "site".
      // The authenticated administrative account may create requests in the app.
      allow create: if hasValidReservationFields()
        && (
          (request.auth == null && request.resource.data.updatedBy == 'site')
          || (
            isStaff()
            && request.resource.data.updatedBy == request.auth.token.email
          )
        );

      // Only authenticated staff can review and update reservation status.
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.status in [
          'Pendente contato', 'Reservado', 'Quitado', 'Visita'
        ]
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isStaff();
    }
  }
}
